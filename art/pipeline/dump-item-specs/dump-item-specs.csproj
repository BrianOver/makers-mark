<!-- Deliberately NOT a member of Game.sln: a local art-pipeline utility, run by hand with
     `dotnet run`, never built by CI and never referenced by the game. Adding it to the solution
     would put it on every CI build's critical path for zero benefit (and Game.sln is on the
     multi-agent deny-list). See README.md in the parent directory for the runbook.

     NOTE: no double hyphen may appear inside this comment. That is illegal XML, and MSBuild fails
     the whole project file with MSB4025 rather than a warning. The same trap already cost this
     repo a silent zero-test CI run once, via .runsettings (see its own header). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dump-item-specs</AssemblyName>
    <RootNamespace>GameArt.Pipeline.DumpItemSpecs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\GameArt\GameArt.csproj" />
  </ItemGroup>
</Project>
