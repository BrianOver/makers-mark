{
  "_comment": "Project-wide Claude Code permission baseline (checked in) — every session AND background subagent on this repo inherits allow/deny (confirmed: sub-agents inherit the parent's rules). Personal extras go in .claude/settings.local.json (gitignored). Scope: build/test/git/gh, common read-only pipe helpers, pinned Godot + ComfyUI + Ollama local tooling, docs-research web domains. IMPORTANT for agents: NEVER cd-prefix commands (a compound is permission-checked per-subcommand, and `cd <path>` is a Read-path check) — use `git -C <abs>`, `gh --repo`, absolute paths, and the Monitor tool instead of `for`/`sleep` poll loops. deny block below is the hard destructive-op boundary (no rm/del, no non-localhost curl).",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git -C *)",
      "Bash(gh *)",
      "Bash(gh api *)",
      "Bash(dotnet *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(ollama *)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(curl http://localhost*)",
      "Bash(/c/Tools/Godot/*)",
      "Bash(/c/Tools/ComfyUI_windows_portable/python_embeded/python.exe *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(printf *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(sleep *)",
      "Bash(awk *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(nvidia-smi *)",
      "PowerShell(dotnet *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Stop-Process *)",
      "PowerShell(Start-Process *)",
      "PowerShell(Get-Content *)",
      "Read(//c/Code/**)",
      "WebSearch",
      "WebFetch(domain:docs.godotengine.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:store.steampowered.com)",
      "WebFetch(domain:reddit.com)",
      "WebFetch(domain:www.reddit.com)",
      "mcp__comfyui"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(del *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "comfyui"
  ]
}
