# Build output
bin/
obj/
*.user

# Godot
.godot/
godot/.godot/
*.translation

# Claude Code worktrees
.claude/worktrees/

# tools/engine-test.ps1's log + receipt — per-machine evidence of the last local suite run,
# never shared (a receipt from another machine proves nothing about yours).
.claude/engine-test/

# Human stable-playable worktree (see HANDOFF.md — double-click play/play.bat)
/play/

# OS / editor
.vs/
.idea/
*.swp
Thumbs.db
.DS_Store

# Test results
TestResults/
*.trx

# Local Claude settings
.claude/settings.local.json

# gdUnit4Net regenerated runner + editor csproj backups
godot/gdunit4_testadapter_v5/
godot/GodotClient.csproj.old*
# Campaign telemetry exports
runs/

# Art pipeline candidate images (curation scratch; only curated pairs get committed)
art/pipeline/candidates/

# FlavorForge dev-time review artifacts (P008) — proposals only, never sim source
tools/FlavorForge/proposals/
tools/FlavorForge/config.json

# Local time-tracking plugin data
.timelog/

# Manual playtest screenshots dropped next to the playable worktree — scratch, never source.
# Untracked they show as dirty forever in Game/play, which makes a real change hard to spot.
playTest_Images/

# tools/agent-playtest.ps1's run artifacts (state/frame/turnlog/findings) - per-run, per-machine.
# The findings worth keeping get committed to docs/playtests/ deliberately.
.claude/agent-playtest/

# Python bytecode from the art generators (tools/art/*.py)
__pycache__/
*.pyc

# Exported game builds. A Windows export is ~160MB (a 104MB self-contained exe, a 62MB
# .pck, and 231 bundled .NET runtime files); it is a build OUTPUT, reproducible from
# godot/export_presets.cfg by tools/export-windows.ps1, and must never enter git history.
build/
